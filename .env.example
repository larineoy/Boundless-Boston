# Set to demo for deterministic fixtures; set to live to call Tier 1 APIs.
APP_MODE=demo
CORS_ORIGINS=http://localhost:5173
CACHE_DB=.cache/public-cache.sqlite3
GOOGLE_MAPS_API_KEY=
# MBTA is public without a key; set one here to raise the project quota.
MBTA_API_KEY=
BOSTON_CKAN_URL=https://data.boston.gov/api/3/action
BOSTON_311_PACKAGE=311-service-requests
BOSTON_LICENSE_PACKAGE=active-food-establishment-licenses

# Cool Finds official APIs; keep every key on the server.
YOUTUBE_API_KEY=
GEMINI_API_KEY=
# Optional: a Gemini model enabled for your account with generateContent + JSON output.
# Without a configured model, users enter the venue clue themselves.
GEMINI_MODEL=
# Set the same strong random secret on every API worker (tokens expire after 15 minutes).
COOL_FINDS_SIGNING_KEY=
