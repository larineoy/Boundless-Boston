# Public API origin, without /api. Use HTTPS for installed production apps.
EXPO_PUBLIC_API_URL=https://boundless-boston-api-5ze8.onrender.com

# For a physical device and local backend, use your computer's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# Android emulator: http://10.0.2.2:8000
# iOS simulator / Expo web: http://localhost:8000

# Required for Google Maps in standalone Android builds (Expo Go supplies its own).
# Restrict this native Maps SDK key to your Android package and signing certificate.
# Keep the backend's Google Places key separate.
# ANDROID_GOOGLE_MAPS_API_KEY=
